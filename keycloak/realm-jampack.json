{
  "realm": "jampack",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "jampack-web",
      "name": "JAMPACK Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173", "+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-jampack-web",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jampack-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@demo.fr",
      "email": "admin@demo.fr",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Demo",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }]
    },
    {
      "username": "compta@demo.fr",
      "email": "compta@demo.fr",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Claire",
      "lastName": "Comptable",
      "credentials": [{ "type": "password", "value": "compta", "temporary": false }]
    }
  ]
}
