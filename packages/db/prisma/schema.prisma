// JAMPACK — socle IAM + CRM (Phase 0 / MVP)
// Hiérarchie : Organization (= compte) ▸ Societe (entité juridique) ▸ données CRM
// Rôles PAR SOCIÉTÉ et CUMULABLES : SocieteRole (userId × societeId × roleId, multiple).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Compte (le tenant / l'abonnement) ──
model Organization {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  theme          Json?           // Look & feel du compte (couleurs de marque)
  memberships    Membership[]
  roles          Role[]
  societes       Societe[]
  societeRoles   SocieteRole[]
  companies      Company[]
  contacts       Contact[]
  opportunities  Opportunity[]
  activities     Activity[]
  pipelineStages PipelineStage[]
  establishments Establishment[]
  taxRates        TaxRate[]
  products        Product[]
  productCategories ProductCategory[]
  societeAddresses  SocieteAddress[]
  factors           Factor[]
  bankAccounts      BankAccount[]
  paymentTerms      PaymentTerm[]
  numberSequences NumberSequence[]
  invoices        Invoice[]
  payments        Payment[]
  warehouses      Warehouse[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  accounts        Account[]
  journals        Journal[]
  journalEntries  JournalEntry[]
  auditLogs       AuditLog[]
  pdpTransmissions PdpTransmission[]
}

// Journal d'audit : trace des mutations (qui, quoi, quand) — traçabilité sécurité/RGPD.
model AuditLog {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societeId      String?
  userId         String?
  action         String       // chemin de la procédure tRPC (ex. invoices.validate)
  metadata       Json?
  createdAt      DateTime     @default(now())
  @@index([organizationId])
  @@index([createdAt])
}

// ── Société gérée dans le compte (entité juridique : compta/factu séparées) ──
model Societe {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  siren          String?
  siret          String?
  tvaNumber      String?
  city           String?
  // ── Paramétrage facturation (en-tête / pied de page des documents) ──
  legalForm      String?   // forme juridique (SARL, SAS…)
  capital        String?   // capital social
  rcs            String?   // RCS
  ape            String?   // code APE/NAF
  addressLine1   String?
  addressLine2   String?
  postalCode     String?
  phone          String?
  email          String?
  website        String?
  logoUrl        String?   // URL ou data: URL du logo
  legalMentions  String?   // mentions légales / pénalités de retard
  cgv            String?   // conditions générales de vente
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  companies      Company[]
  contacts       Contact[]
  opportunities  Opportunity[]
  activities     Activity[]
  societeRoles   SocieteRole[]
  establishments Establishment[]
  products        Product[]
  productCategories ProductCategory[]
  societeAddresses  SocieteAddress[]
  factors           Factor[]
  bankAccounts      BankAccount[]
  paymentTerms      PaymentTerm[]
  numberSequences NumberSequence[]
  invoices        Invoice[]
  payments        Payment[]
  warehouses      Warehouse[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  accounts        Account[]
  journals        Journal[]
  journalEntries  JournalEntry[]
  pdpTransmissions PdpTransmission[]
  @@unique([organizationId, name])
  @@index([organizationId])
}

// E-invoicing : transmission d'une facture via une PDP (Plateforme de Dématérialisation Partenaire).
model PdpTransmission {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  provider       String       // simulated | <nom PDP>
  status         String       // sent | accepted | rejected
  providerRef    String?
  format         String       @default("factur-x")
  createdAt      DateTime     @default(now())
  @@index([organizationId])
  @@index([societeId])
  @@index([invoiceId])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  memberships  Membership[]
  societeRoles SocieteRole[]
}

// ── Appartenance au compte (accès au tenant, sans rôle : les rôles sont par société) ──
model Membership {
  id             String       @id @default(cuid())
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ── Définition de rôle (réutilisable dans les sociétés du compte) ──
model Role {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  permissions    Permission[]
  societeRoles   SocieteRole[]
  @@unique([organizationId, name])
}

// ── Attribution d'un rôle à un utilisateur DANS une société (cumulable) ──
model SocieteRole {
  id             String       @id @default(cuid())
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  role           Role         @relation(fields: [roleId], references: [id])
  roleId         String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  @@unique([userId, societeId, roleId])
  @@index([organizationId])
  @@index([userId])
  @@index([societeId])
}

model Permission {
  id      String @id @default(cuid())
  action  String
  subject String
  roles   Role[]
  @@unique([action, subject])
}

// ── CRM (rattaché à une Societe) ──
model Company {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe       @relation(fields: [societeId], references: [id])
  societeId      String
  name           String
  siren          String?
  isCustomer     Boolean       @default(true)
  isSupplier     Boolean       @default(false)
  contacts       Contact[]
  opportunities  Opportunity[]
  establishments Establishment[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  factor          Factor?      @relation(fields: [factorId], references: [id])
  factorId        String?
  factorMandatory Boolean      @default(false)
  paymentTerm     PaymentTerm? @relation(fields: [paymentTermId], references: [id])
  paymentTermId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  @@index([organizationId])
  @@index([societeId])
  @@index([factorId])
}

model Contact {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  company         Company?       @relation(fields: [companyId], references: [id])
  companyId       String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  establishmentId String?
  firstName       String
  lastName        String
  email           String?
  phone           String?
  activities      Activity[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId])
  @@index([societeId])
}

model PipelineStage {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  order          Int
  opportunities  Opportunity[]
  @@unique([organizationId, name])
}

model Opportunity {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe       @relation(fields: [societeId], references: [id])
  societeId      String
  company        Company?      @relation(fields: [companyId], references: [id])
  companyId      String?
  title          String
  amount         Decimal?      @db.Decimal(12, 2)
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  stageId        String
  activities     Activity[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([organizationId])
  @@index([societeId])
}

model Activity {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  type           String
  content        String
  dueAt          DateTime?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  contactId      String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  opportunityId  String?
  createdAt      DateTime     @default(now())
  createdById    String?
  @@index([organizationId])
  @@index([societeId])
}

// ── Établissement d'un client (adresse ; siège / facturation / livraison) ──
model Establishment {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  company        Company      @relation(fields: [companyId], references: [id])
  companyId      String
  name           String       // ex. Siège, Agence Lyon, Entrepôt
  siret          String?      // 14 chiffres (propre à l'établissement)
  addressLine1   String?
  addressLine2   String?
  postalCode     String?
  city           String?
  country        String       @default("France")
  phone          String?
  email          String?
  isHeadquarters Boolean      @default(false)
  isBilling      Boolean      @default(false)
  isDelivery     Boolean      @default(false)
  contacts       Contact[]
  invoices       Invoice[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId])
  @@index([societeId])
  @@index([companyId])
}

// ── Référentiels ──

// Taux de TVA (niveau compte, partagés par les sociétés)
model TaxRate {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String       // ex. "TVA 20 %"
  rate           Decimal      @db.Decimal(5, 2) // 20.00
  isDefault      Boolean      @default(false)
  products       Product[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([organizationId, name])
  @@index([organizationId])
}

// Articles & services (catalogue, par société)
model Product {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  reference      String?      // SKU
  name           String
  description    String?
  kind           String       @default("bien") // "bien" | "service"
  unit           String       @default("unité")
  priceHt        Decimal      @db.Decimal(12, 2) @default(0)
  taxRate        TaxRate?     @relation(fields: [taxRateId], references: [id])
  taxRateId      String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  categoryId     String?
  invoiceLines   InvoiceLine[]
  stockMovements StockMovement[]
  purchaseLines  PurchaseOrderLine[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId])
  @@index([societeId])
  @@index([categoryId])
}

// ── Stock : entrepôts et mouvements (par société) ──
model Warehouse {
  id             String          @id @default(cuid())
  organization   Organization    @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe         @relation(fields: [societeId], references: [id])
  societeId      String
  name           String
  code           String?
  addressLine1   String?
  postalCode     String?
  city           String?
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)
  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  @@index([organizationId])
  @@index([societeId])
}

model StockMovement {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  warehouseId    String
  product        Product      @relation(fields: [productId], references: [id])
  productId      String
  kind           String       // entree | sortie | ajustement
  quantity       Decimal      @db.Decimal(12, 3) // signé : + entrée, − sortie
  unitCost       Decimal?     @db.Decimal(12, 2) // coût unitaire (valorisation PMP — futur)
  note           String?
  date           DateTime     @default(now())
  createdById    String?
  createdAt      DateTime     @default(now())
  @@index([organizationId])
  @@index([societeId])
  @@index([warehouseId])
  @@index([productId])
}

// ── Achats : commandes fournisseurs (le fournisseur est une Company isSupplier) ──
model PurchaseOrder {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  supplier       Company      @relation(fields: [supplierId], references: [id])
  supplierId     String
  warehouse      Warehouse?   @relation(fields: [warehouseId], references: [id])
  warehouseId    String?      // entrepôt de destination des réceptions
  number         String?      // null tant que brouillon ; attribué à la validation
  status         String       @default("draft") // draft | sent | received | cancelled
  orderDate      DateTime?
  expectedDate   DateTime?
  notes          String?
  lines          PurchaseOrderLine[]
  supplierInvoices SupplierInvoice[]
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([societeId, number])
  @@index([organizationId])
  @@index([societeId])
  @@index([supplierId])
}

// ── Achats : factures fournisseurs (comptes à payer) ──
model SupplierInvoice {
  id              String         @id @default(cuid())
  organization    Organization   @relation(fields: [organizationId], references: [id])
  organizationId  String
  societe         Societe        @relation(fields: [societeId], references: [id])
  societeId       String
  supplier        Company        @relation(fields: [supplierId], references: [id])
  supplierId      String
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?
  reference       String?        // n° de facture émis par le fournisseur
  status          String         @default("draft") // draft | validated | paid | cancelled
  issueDate       DateTime?
  dueDate         DateTime?
  paidDate        DateTime?
  notes           String?
  lines           SupplierInvoiceLine[]
  payments        SupplierPayment[]
  journalEntry    JournalEntry?  @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  journalEntryId  String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@index([organizationId])
  @@index([societeId])
  @@index([supplierId])
}

model SupplierPayment {
  id                String          @id @default(cuid())
  organization      Organization    @relation(fields: [organizationId], references: [id])
  organizationId    String
  societe           Societe         @relation(fields: [societeId], references: [id])
  societeId         String
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  supplierInvoiceId String
  amount            Decimal         @db.Decimal(12, 2)
  date              DateTime        @default(now())
  method            String          @default("virement") // virement | cheque | cb | especes | prelevement
  reference         String?
  note              String?
  journalEntry      JournalEntry?   @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  journalEntryId    String?
  createdById       String?
  createdAt         DateTime        @default(now())
  @@index([organizationId])
  @@index([societeId])
  @@index([supplierInvoiceId])
}

model SupplierInvoiceLine {
  id          String          @id @default(cuid())
  invoice     SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  label       String
  quantity    Decimal         @db.Decimal(12, 3) @default(1)
  unitPriceHt Decimal         @db.Decimal(12, 2) @default(0)
  taxRatePct  Decimal         @db.Decimal(5, 2)  @default(0)
  position    Int             @default(0)
  @@index([invoiceId])
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  product          Product?      @relation(fields: [productId], references: [id])
  productId        String?
  label            String
  quantity         Decimal       @db.Decimal(12, 3) @default(1)
  unitPriceHt      Decimal       @db.Decimal(12, 2) @default(0)
  quantityReceived Decimal       @db.Decimal(12, 3) @default(0)
  position         Int           @default(0)
  @@index([orderId])
}

// ── Catégories d'articles (référentiel par société, hiérarchie optionnelle) ──
model ProductCategory {
  id             String            @id @default(cuid())
  organization   Organization      @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe           @relation(fields: [societeId], references: [id])
  societeId      String
  name           String
  parent         ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  parentId       String?
  children       ProductCategory[] @relation("CategoryTree")
  position       Int               @default(0)
  isActive       Boolean           @default(true)
  products       Product[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  @@unique([societeId, name])
  @@index([organizationId])
  @@index([societeId])
  @@index([parentId])
}

// ── Adresses de la société — plusieurs par société (siège, facturation…) ──
model SocieteAddress {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  label          String       // ex. "Siège", "Facturation"
  addressLine1   String?
  addressLine2   String?
  postalCode     String?
  city           String?
  country        String?
  isHeadquarters Boolean      @default(false)
  isBilling      Boolean      @default(false)
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId])
  @@index([societeId])
}

// ── Affactureurs (subrogation) — plusieurs par société ──
model Factor {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  name           String
  iban           String?
  bic            String?
  isActive       Boolean      @default(true)
  companies      Company[]
  invoices       Invoice[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId])
  @@index([societeId])
}

// ── Coordonnées bancaires — plusieurs par société ──
model BankAccount {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  label          String       // ex. "Compte courant", "Crédit Agricole"
  iban           String
  bic            String?
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  invoices       Invoice[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId])
  @@index([societeId])
}

// ── Conditions de paiement — plusieurs par société ──
model PaymentTerm {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  label          String       // ex. "30 jours", "Comptant"
  days           Int          @default(30) // délai d'échéance en jours
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  companies      Company[]
  invoices       Invoice[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId])
  @@index([societeId])
}

// ── Facturation ──
model Invoice {
  id              String         @id @default(cuid())
  organization    Organization   @relation(fields: [organizationId], references: [id])
  organizationId  String
  societe         Societe        @relation(fields: [societeId], references: [id])
  societeId       String
  company         Company        @relation(fields: [companyId], references: [id])
  companyId       String
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  establishmentId String?
  factor          Factor?        @relation(fields: [factorId], references: [id])
  factorId        String?
  bankAccount     BankAccount?   @relation(fields: [bankAccountId], references: [id])
  bankAccountId   String?
  paymentTerm     PaymentTerm?   @relation(fields: [paymentTermId], references: [id])
  paymentTermId   String?
  // Type de pièce de vente : un seul modèle sert le devis, la facture et l'avoir.
  docType         String         @default("facture") // devis | facture | avoir
  // Filiation entre pièces : devis → facture → avoir (traçabilité de la conversion).
  source          Invoice?       @relation("DocLineage", fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId        String?
  derived         Invoice[]      @relation("DocLineage")
  number          String?        // null tant que brouillon ; attribué à la validation
  // Statuts selon docType :
  //   facture : draft | validated | paid | cancelled
  //   devis   : draft | sent | accepted | refused | converted | cancelled
  //   avoir   : draft | validated | cancelled
  status          String         @default("draft")
  issueDate       DateTime?
  dueDate         DateTime?      // facture : échéance de règlement
  validUntil      DateTime?      // devis : date de validité
  notes           String?
  lines           InvoiceLine[]
  payments        Payment[]
  pdpTransmissions PdpTransmission[]
  // Comptabilisation : écriture générée (journal des ventes) — null tant que non comptabilisée.
  journalEntry    JournalEntry?  @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  journalEntryId  String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@unique([societeId, number])
  @@index([organizationId])
  @@index([societeId])
  @@index([companyId])
  @@index([societeId, docType])
  @@index([sourceId])
}

model InvoiceLine {
  id           String   @id @default(cuid())
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId    String
  product      Product? @relation(fields: [productId], references: [id])
  productId    String?
  label        String
  quantity     Decimal  @db.Decimal(12, 3) @default(1)
  unitPriceHt  Decimal  @db.Decimal(12, 2) @default(0)
  taxRatePct   Decimal  @db.Decimal(5, 2)  @default(0) // taux figé sur la ligne
  position     Int      @default(0)
  @@index([invoiceId])
}

// Règlement (encaissement) rattaché à une facture
model Payment {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  amount         Decimal      @db.Decimal(12, 2)
  date           DateTime     @default(now())
  method         String       @default("virement") // virement | cheque | cb | especes | prelevement
  reference      String?
  note           String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  journalEntryId String?
  createdById    String?
  createdAt      DateTime     @default(now())
  @@index([organizationId])
  @@index([societeId])
  @@index([invoiceId])
}

// Numérotation des pièces (par société et par type de document)
model NumberSequence {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  docType        String       // "facture" | "devis" | "avoir" | "commande"
  prefix         String       @default("")
  nextValue      Int          @default(1)
  padding        Int          @default(4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([societeId, docType])
  @@index([organizationId])
}

// ── Comptabilité : plan comptable, journaux, écritures (par société) ──
model Account {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  code           String       // n° de compte PCG (ex. 411000, 707000)
  name           String
  class          Int          // classe PCG (1..7), dérivée du 1er chiffre du code
  isActive       Boolean      @default(true)
  lines          JournalEntryLine[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([societeId, code])
  @@index([organizationId])
  @@index([societeId])
}

model Journal {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  code           String       // VT, AC, BQ, OD
  name           String
  type           String       // vente | achat | banque | od
  entries        JournalEntry[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([societeId, code])
  @@index([organizationId])
  @@index([societeId])
}

model JournalEntry {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  societe        Societe      @relation(fields: [societeId], references: [id])
  societeId      String
  journal        Journal      @relation(fields: [journalId], references: [id])
  journalId      String
  date           DateTime
  reference      String?      // pièce liée (ex. n° de facture)
  label          String
  lines          JournalEntryLine[]
  salesInvoice   Invoice[]         // facture(s) de vente comptabilisée(s) par cette écriture
  payments       Payment[]         // règlement(s) client comptabilisé(s)
  supplierInvoices SupplierInvoice[] // facture(s) fournisseur comptabilisée(s)
  supplierPayments SupplierPayment[] // règlement(s) fournisseur comptabilisé(s)
  createdById    String?
  createdAt      DateTime     @default(now())
  @@index([organizationId])
  @@index([societeId])
  @@index([journalId])
}

model JournalEntryLine {
  id        String       @id @default(cuid())
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId   String
  account   Account      @relation(fields: [accountId], references: [id])
  accountId String
  label     String?
  debit     Decimal      @db.Decimal(14, 2) @default(0)
  credit    Decimal      @db.Decimal(14, 2) @default(0)
  letter    String?      // code de lettrage (rapprochement débit/crédit)
  position  Int          @default(0)
  @@index([entryId])
  @@index([accountId])
}
