{
  "name": "jampack",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:migrate": "pnpm --filter @jampack/db migrate",
    "db:seed": "pnpm --filter @jampack/db seed",
    "db:rls": "pnpm --filter @jampack/db rls"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
