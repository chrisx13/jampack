{
  "name": "jampack",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run -c vitest.integration.config.ts",
    "db:migrate": "pnpm --filter @jampack/db migrate",
    "db:seed": "pnpm --filter @jampack/db seed",
    "db:rls": "pnpm --filter @jampack/db rls",
    "security:audit": "pnpm audit --audit-level=high"
  },
  "pnpm": {
    "overrides": {
      "body-parser": ">=1.20.6",
      "qs": ">=6.15.2",
      "nanoid": ">=3.3.17",
      "multer": ">=2.2.0",
      "tmp": ">=0.2.6",
      "glob": ">=10.5.0",
      "file-type": ">=21.3.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.9.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8",
    "vitest": "^2.1.9"
  }
}
